{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://w3id.org/graft/manifest/2.0.0",
  "title": "graft compiled schema manifest",
  "type": "object",
  "required": [
    "manifest_version",
    "projection_mapping_version",
    "schema",
    "classes",
    "slots",
    "enums",
    "relations",
    "graph_projections",
    "validation_invariants",
    "identifier_normalization_versions",
    "compiler",
    "fingerprints"
  ],
  "properties": {
    "manifest_version": {
      "const": "2.0.0"
    },
    "projection_mapping_version": {
      "const": "1"
    },
    "schema": {
      "type": "object",
      "required": ["id", "name", "version", "source_files"],
      "properties": {
        "id": {"$ref": "#/$defs/uri"},
        "name": {"type": "string", "minLength": 1},
        "version": {"type": ["string", "null"]},
        "source_files": {
          "type": "array",
          "minItems": 1,
          "contains": {
            "type": "object",
            "required": ["root"],
            "properties": {"root": {"const": true}}
          },
          "minContains": 1,
          "maxContains": 1,
          "items": {
            "type": "object",
            "required": [
              "schema_id",
              "name",
              "version",
              "content_digest",
              "root"
            ],
            "properties": {
              "schema_id": {"$ref": "#/$defs/nullable_uri"},
              "name": {"type": "string"},
              "version": {"type": ["string", "null"]},
              "content_digest": {"$ref": "#/$defs/digest"},
              "root": {"type": "boolean"}
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "classes": {
      "type": "object",
      "additionalProperties": {"$ref": "#/$defs/class"}
    },
    "slots": {
      "type": "object",
      "additionalProperties": {"$ref": "#/$defs/slot"}
    },
    "enums": {
      "type": "object",
      "additionalProperties": {"$ref": "#/$defs/enum"}
    },
    "relations": {
      "type": "array",
      "items": {"$ref": "#/$defs/relation"}
    },
    "graph_projections": {"$ref": "#/$defs/graph_projections"},
    "validation_invariants": {
      "type": "array",
      "items": {"$ref": "#/$defs/validation_invariant"}
    },
    "identifier_normalization_versions": {
      "type": "object",
      "additionalProperties": {"type": "string"}
    },
    "compiler": {
      "type": "object",
      "required": [
        "name",
        "version",
        "script_digest"
      ],
      "properties": {
        "name": {"type": "string"},
        "version": {"type": "string"},
        "script_digest": {"$ref": "#/$defs/digest"},
        "python_version": {"type": "string"},
        "linkml_runtime_version": {"type": "string"},
        "provider": {"$ref": "#/$defs/data_dict_provider"}
      },
      "additionalProperties": false
    },
    "fingerprints": {
      "type": "object",
      "required": ["structural_digest", "source_digest", "build_digest"],
      "properties": {
        "structural_digest": {"$ref": "#/$defs/digest"},
        "source_digest": {"$ref": "#/$defs/digest"},
        "build_digest": {"$ref": "#/$defs/digest"}
      },
      "additionalProperties": false
    },
    "dictionary": {"$ref": "#/$defs/data_dict_dictionary"}
  },
  "allOf": [
    {
      "if": {"required": ["dictionary"]},
      "then": {
        "properties": {
          "compiler": {
            "required": ["name", "version", "script_digest", "provider"],
            "propertyNames": {
              "enum": ["name", "version", "script_digest", "provider"]
            },
            "properties": {
              "name": {"const": "graft-data-dict-adapter"},
              "version": {"const": "0.1.0"},
              "script_digest": {
                "const": "sha256:462914f4341212bbf816e92774e8ae6ea19c1d2fbeba117330f40dbc026d9780"
              }
            }
          },
          "schema": {
            "properties": {
              "source_files": {
                "minItems": 1,
                "maxItems": 1,
                "items": {
                  "required": [
                    "schema_id",
                    "name",
                    "version",
                    "content_digest",
                    "root"
                  ]
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "compiler": {
            "properties": {
              "name": {"const": "graft-data-dict-adapter"}
            }
          }
        }
      },
      "then": {
        "required": ["dictionary"],
        "properties": {
          "compiler": {"required": ["provider"]}
        }
      }
    },
    {
      "if": {"not": {"required": ["dictionary"]}},
      "then": {
        "properties": {
          "compiler": {
            "propertyNames": {
              "enum": [
                "name",
                "version",
                "script_digest",
                "python_version",
                "linkml_runtime_version"
              ]
            },
            "properties": {
              "name": {"const": "graft-linkml-compiler"},
              "version": {"const": "0.3.0"},
              "script_digest": {
                "const": "sha256:2720893b91978930cbdf3f99feadf9bd96822fdf8ece018c7711af9914f42a7d"
              }
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "uri": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[A-Za-z][A-Za-z0-9+.-]*:"
    },
    "uri_or_curie": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[A-Za-z_][A-Za-z0-9._+-]*:"
    },
    "nullable_uri": {
      "oneOf": [
        {"$ref": "#/$defs/uri"},
        {"type": "null"}
      ]
    },
    "nullable_uri_or_curie": {
      "oneOf": [
        {"$ref": "#/$defs/uri_or_curie"},
        {"type": "null"}
      ]
    },
    "data_dict_provider": {
      "type": "object",
      "required": ["name", "export_format_version", "source_format"],
      "properties": {
        "name": {"const": "data-dict"},
        "export_format_version": {"const": "0.1.0"},
        "source_spec_version": {"type": ["string", "null"]},
        "cli_version": {"type": ["string", "null"]},
        "cli_digest": {
          "oneOf": [
            {"$ref": "#/$defs/digest"},
            {"type": "null"}
          ]
        },
        "revision": {"type": ["string", "null"]},
        "source_format": {
          "enum": ["yaml", "resolved_json"]
        }
      },
      "additionalProperties": false
    },
    "data_dict_loss": {
      "type": "object",
      "required": ["status", "handling"],
      "properties": {
        "status": {"type": "string", "minLength": 1},
        "handling": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "data_dict_public_column": {
      "type": "object",
      "properties": {
        "examples": false,
        "range": false,
        "profile": false,
        "fields": false
      }
    },
    "data_dict_dictionary": {
      "type": "object",
      "required": [
        "provider",
        "document",
        "profile",
        "defaults",
        "adapter_version",
        "requirements",
        "mapped",
        "preserved",
        "not_enforced"
      ],
      "properties": {
        "provider": {"$ref": "#/$defs/data_dict_provider"},
        "document": {
          "type": "object",
          "required": ["$version"],
          "properties": {
            "$version": {"const": "0.1.0"},
            "origin": false,
            "tables": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "origin": false,
                  "source": false,
                  "rows": false,
                  "columns": {
                    "type": "array",
                    "items": {"$ref": "#/$defs/data_dict_public_column"}
                  }
                }
              }
            }
          }
        },
        "profile": {"const": "graft-table-v1"},
        "defaults": {
          "type": "object",
          "required": ["role", "id_policy", "id_format"],
          "properties": {
            "role": {"const": "node"},
            "id_policy": {"const": "require"},
            "id_format": {"const": "linkml"}
          },
          "additionalProperties": false
        },
        "adapter_version": {"const": "0.1.0"},
        "requirements": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1}
        },
        "mapped": {
          "type": "object",
          "required": [
            "tables_to_classes",
            "columns_to_slots",
            "enums",
            "foreign_keys_to_object_references",
            "list_columns_to_relations",
            "restricted_display_to_sensitive"
          ],
          "properties": {
            "tables_to_classes": {"type": "integer", "minimum": 1},
            "columns_to_slots": {"type": "integer", "minimum": 1},
            "enums": {"type": "integer", "minimum": 0},
            "foreign_keys_to_object_references": {
              "type": "integer",
              "minimum": 0
            },
            "list_columns_to_relations": {
              "type": "integer",
              "minimum": 0
            },
            "restricted_display_to_sensitive": {"type": "boolean"}
          },
          "additionalProperties": false
        },
        "preserved": {
          "type": "array",
          "items": {"type": "string", "minLength": 1}
        },
        "not_enforced": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {"$ref": "#/$defs/data_dict_loss"}
        }
      },
      "additionalProperties": false
    },
    "validation_invariant": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "name",
            "applies_to_role",
            "fields",
            "rule",
            "minimum",
            "maximum"
          ],
          "properties": {
            "name": {"const": "confidence_bounds"},
            "applies_to_role": {"const": "statement"},
            "fields": {"const": ["confidence"]},
            "rule": {"const": "null_or_between_inclusive"},
            "minimum": {"const": 0},
            "maximum": {"const": 1}
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["name", "applies_to_role", "fields", "rule"],
          "properties": {
            "name": {"const": "valid_time_order"},
            "applies_to_role": {"const": "statement"},
            "fields": {"const": ["valid_from", "valid_to"]},
            "rule": {"const": "null_or_less_than_or_equal"}
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "name",
            "class",
            "required_fields",
            "forbidden_fields",
            "rule"
          ],
          "properties": {
            "name": {"const": "narrative_shape"},
            "class": {"type": "string"},
            "required_fields": {"const": ["statement_text"]},
            "forbidden_fields": {
              "const": [
                "predicate",
                "object_entity",
                "object_value",
                "object_datatype"
              ]
            },
            "rule": {"const": "required_and_forbidden_fields"}
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["name", "class", "fields", "cardinality", "rule"],
          "properties": {
            "name": {"const": "exactly_one_semantic_object"},
            "class": {"type": "string"},
            "fields": {"const": ["object_entity", "object_value"]},
            "cardinality": {"const": 1},
            "rule": {"const": "exactly_one_present"}
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["name", "class", "fields", "rule"],
          "properties": {
            "name": {"const": "semantic_literal_datatype"},
            "class": {"type": "string"},
            "fields": {"const": ["object_value", "object_datatype"]},
            "rule": {"const": "datatype_when_not_inferable"}
          },
          "additionalProperties": false
        }
      ]
    },
    "graph_projections": {
      "type": "object",
      "required": ["node_classes", "semantic_edges", "provenance_edges"],
      "properties": {
        "node_classes": {
          "type": "array",
          "items": {"type": "string"}
        },
        "semantic_edges": {
          "type": "object",
          "required": [
            "direct_edge_classes",
            "semantic_statement_classes",
            "object_relations",
            "exclude_narrative_statements"
          ],
          "properties": {
            "direct_edge_classes": {
              "type": "array",
              "items": {"type": "string"}
            },
            "semantic_statement_classes": {
              "type": "array",
              "items": {"type": "string"}
            },
            "object_relations": {
              "type": "array",
              "items": {"type": "string"}
            },
            "exclude_narrative_statements": {"const": true}
          },
          "additionalProperties": false
        },
        "provenance_edges": {
          "type": "object",
          "required": [
            "narrative_statement_classes",
            "narrative_slots",
            "statement_to_evidence",
            "evidence_to_source",
            "supersession",
            "mention_resolution",
            "semantic_derivation"
          ],
          "properties": {
            "narrative_statement_classes": {
              "type": "array",
              "items": {"type": "string"}
            },
            "narrative_slots": {
              "const": ["about", "primary_subject"]
            },
            "statement_to_evidence": {"const": true},
            "evidence_to_source": {"const": true},
            "supersession": {"const": true},
            "mention_resolution": {"const": true},
            "semantic_derivation": {"const": true}
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "class": {
      "type": "object",
      "required": [
        "name",
        "role",
        "view",
        "id_policy",
        "id_format",
        "type_uri",
        "slots",
        "relations"
      ],
      "properties": {
        "name": {"type": "string"},
        "is_a": {"type": ["string", "null"]},
        "ancestors": {"type": "array", "items": {"type": "string"}},
        "type_uri": {"$ref": "#/$defs/uri"},
        "role": {
          "enum": [
            "node",
            "edge",
            "statement",
            "evidence",
            "source",
            "mention",
            "metadata"
          ]
        },
        "statement_shape": {
          "type": ["string", "null"],
          "enum": ["narrative", "semantic", null]
        },
        "view": {"type": "string"},
        "id_policy": {
          "enum": ["require", "mint", "resolve_exact", "deterministic"]
        },
        "id_format": {
          "enum": ["graft", "linkml"]
        },
        "label_slot": {"type": ["string", "null"]},
        "search_slots": {"type": "array", "items": {"type": "string"}},
        "origin_key_slots": {"type": "array", "items": {"type": "string"}},
        "qualifier_slots": {"type": "array", "items": {"type": "string"}},
        "fixed_predicate": {"$ref": "#/$defs/nullable_uri_or_curie"},
        "slots": {
          "type": "object",
          "additionalProperties": {"$ref": "#/$defs/slot"}
        },
        "relations": {"type": "array", "items": {"type": "string"}}
      },
      "additionalProperties": false
    },
    "slot": {
      "type": "object",
      "required": [
        "name",
        "range",
        "duckdb_type",
        "required",
        "multivalued",
        "identifier",
        "object_reference"
      ],
      "properties": {
        "name": {"type": "string"},
        "view_column": {"type": ["string", "null"]},
        "range": {"type": "string"},
        "duckdb_type": {"type": "string"},
        "required": {"type": "boolean"},
        "multivalued": {"type": "boolean"},
        "ordered": {"type": "boolean"},
        "identifier": {"type": "boolean"},
        "object_reference": {"type": "boolean"},
        "enum": {"type": ["string", "null"]},
        "meaning": {"$ref": "#/$defs/nullable_uri_or_curie"},
        "pattern": {"type": ["string", "null"]},
        "datetime_format": {
          "enum": ["offset", "local_utc", null]
        },
        "minimum_value": {"type": ["number", "null"]},
        "maximum_value": {"type": ["number", "null"]},
        "external_identifier": {"type": ["string", "null"]},
        "search_weight": {"type": ["number", "null"]},
        "sensitive": {"type": "boolean"}
      },
      "additionalProperties": false
    },
    "enum": {
      "type": "object",
      "required": ["name", "permissible_values"],
      "properties": {
        "name": {"type": "string"},
        "description": {"type": ["string", "null"]},
        "permissible_values": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["value"],
            "properties": {
              "value": {"type": "string"},
              "meaning": {"$ref": "#/$defs/nullable_uri_or_curie"},
              "description": {"type": ["string", "null"]}
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "relation": {
      "type": "object",
      "required": [
        "name",
        "view",
        "owner_class",
        "owner_view",
        "slot",
        "kind",
        "ordered",
        "predicate"
      ],
      "properties": {
        "name": {"type": "string"},
        "view": {"type": "string"},
        "owner_class": {"type": "string"},
        "owner_view": {"type": "string"},
        "slot": {"type": "string"},
        "kind": {"enum": ["object", "value"]},
        "ordered": {"type": "boolean"},
        "predicate": {"$ref": "#/$defs/uri_or_curie"}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
