{"$version":"0.1.0","name":"artifacts","label":"Kept artifacts","description":"<p>Results a person kept from an assistant conversation: each artifact, its versions and their bytes, how each version was made, and the citations, evidence, and directions recorded with it.</p>","details":"<p>Shaped on Crucible's kept artifacts, provenance records, evidence table, and directions log. Live conversation cards are not stored here; a card becomes an artifact when someone keeps it.</p>","learn_more":"https://data-dict.tidyverse.org/","version":{"number":"0.1.0"},"tables":[{"name":"graft_blob","label":"Blobs","description":"<p>Each row is one immutable byte sequence, named by its digest.</p>","columns":[{"name":"id","label":"Blob ID","description":"<p>SHA-256 digest of the bytes, as <code>sha256:&lt;hex&gt;</code>.</p>","type":"string","constraints":["primary_key","unique","required"],"referenced_by":[{"table":"artifact_version","column":"blob_id"}],"examples":["sha256:9f86d081884c7d659a2feaa0c55ad015a3bf4f1b2b0b822cd15d6c15b0f00a08"]},{"name":"media_type","label":"Media type","description":"<p>Media type of the bytes.</p>","type":"string","constraints":["required"],"examples":["image/png","text/html"]},{"name":"size_bytes","label":"Size","description":"<p>Length of the bytes.</p>","type":"number(quantity)","units":"bytes","constraints":["required"],"range":{"min":0,"max":null},"examples":[1024]}]},{"name":"artifact","label":"Artifacts","description":"<p>Each row is one artifact a person kept to a project.</p>","columns":[{"name":"id","label":"Artifact ID","description":"<p>Stable identifier across versions.</p>","type":"string","constraints":["primary_key","unique","required"],"referenced_by":[{"table":"artifact_version","column":"artifact_id"}],"examples":["artifact:polymer-cure:conv-7:card-12"]},{"name":"project_id","label":"Project","description":"<p>Project the artifact was kept to.</p>","type":"string","constraints":["required"],"examples":["polymer-cure"]},{"name":"title","label":"Title","description":"<p>Title shown on the card.</p>","type":"string","constraints":["required"],"examples":["Cure conversion by protocol"]},{"name":"kind","label":"Kind","description":"<p>Whether a live app or a static result made the artifact.</p>","type":"enum","constraints":["required"],"values":["app","result","note"]},{"name":"tool","label":"Tool","description":"<p>Tool whose call produced the artifact.</p>","type":"string","examples":["run_r_code","create_evidence_table"]},{"name":"label","label":"Label","description":"<p>Label that groups a card's versions in its conversation.</p>","type":"string","examples":["conversion-plot"]},{"name":"conversation_id","label":"Conversation","description":"<p>Conversation the artifact was made in.</p>","type":"string","constraints":["required"],"examples":["conv-7"]},{"name":"conversation_title","label":"Conversation title","description":"<p>Title of that conversation when the artifact was kept.</p>","type":"string","examples":["Cure protocol comparison"]},{"name":"kept_by","label":"Kept by","description":"<p>Person who kept the artifact.</p>","type":"string","constraints":["required"],"examples":["ua21849"]},{"name":"kept_at","label":"Kept at","description":"<p>When the artifact was kept.</p>","type":"datetime","time_zone":"UTC","constraints":["required"],"range":{"min":"2026-01-01T00:00:00","max":null}}]},{"name":"artifact_provenance","label":"Provenance","description":"<p>Each row records how one artifact version was made.</p>","columns":[{"name":"id","label":"Provenance ID","description":"<p>Stable identifier for the record.</p>","type":"string","constraints":["primary_key","unique","required"],"referenced_by":[{"table":"artifact_version","column":"provenance_id"}],"examples":["provenance:conv-7:card-12:v2"]},{"name":"producer","label":"Producer","description":"<p>Tool or app that made the version.</p>","type":"string","constraints":["required"],"examples":["run_r_code","alloptr"]},{"name":"server","label":"Server","description":"<p>MCP server that served the tool, when one did.</p>","type":"string","examples":["alloptr","dowchem"]},{"name":"runtime","label":"Runtime","description":"<p>Language runtime that made the version.</p>","type":"enum","constraints":["required"],"values":["r","python","node","dotnet"]},{"name":"package","label":"Package","description":"<p>Package that provided the producer.</p>","type":"string","examples":["alloptr"]},{"name":"package_version","label":"Package version","description":"<p>Version of that package.</p>","type":"string","examples":["0.4.1"]},{"name":"capture","label":"Capture","description":"<p>How much of the making is kept: <code>exact</code> when the code is kept, <code>declared</code> when the assistant wrote the content, <code>partial</code> otherwise.</p>","type":"enum","constraints":["required"],"values":["exact","declared","partial"]},{"name":"code","label":"Code","description":"<p>Code that ran, when capture is exact.</p>","type":"string","examples":["ggplot(runs, aes(time, conversion)) + geom_line()"]},{"name":"model","label":"Model","description":"<p>Model that made the call.</p>","type":"string","examples":["gpt-5.6-sol"]},{"name":"conversation_id","label":"Conversation","description":"<p>Conversation the call was made in.</p>","type":"string","constraints":["required"],"examples":["conv-7"]},{"name":"tool_call_id","label":"Tool call","description":"<p>Identifier of the tool call within the conversation.</p>","type":"string","examples":["call_8f2a"]},{"name":"recorded_at","label":"Recorded at","description":"<p>When the record was made.</p>","type":"datetime","time_zone":"UTC","constraints":["required"],"range":{"min":"2026-01-01T00:00:00","max":null}}]},{"name":"artifact_version","label":"Artifact versions","description":"<p>Each row is one version of an artifact and its bytes.</p>","columns":[{"name":"id","label":"Version ID","description":"<p>Stable identifier for the version.</p>","type":"string","constraints":["primary_key","unique","required"],"referenced_by":[{"table":"evidence_claim","column":"artifact_version_id"}],"examples":["artifact:polymer-cure:conv-7:card-12:v2"]},{"name":"artifact_id","label":"Artifact","description":"<p>Artifact this is a version of.</p>","type":"string","constraints":["foreign_key","required"],"references":{"table":"artifact","column":"id"},"examples":["artifact:polymer-cure:conv-7:card-12"]},{"name":"version","label":"Version","description":"<p>Version number within the artifact, from 1.</p>","type":"number(ordinal)","constraints":["required"],"range":{"min":1,"max":null}},{"name":"blob_id","label":"Content","description":"<p>Bytes of the version as shown.</p>","type":"string","constraints":["foreign_key","required"],"references":{"table":"graft_blob","column":"id"},"examples":["sha256:9f86d081884c7d659a2feaa0c55ad015a3bf4f1b2b0b822cd15d6c15b0f00a08"]},{"name":"text","label":"Text","description":"<p>Plain-text fallback for hosts that cannot show the bytes.</p>","type":"string","examples":["Conversion reaches 0.92 at 60 min for the 80C protocol."]},{"name":"provenance_id","label":"Provenance","description":"<p>How this version was made.</p>","type":"string","constraints":["foreign_key","required"],"references":{"table":"artifact_provenance","column":"id"},"examples":["provenance:conv-7:card-12:v2"]}]},{"name":"citation","label":"Citations","description":"<p>Each row is one reference a result cited.</p>","columns":[{"name":"id","label":"Citation ID","description":"<p>Stable identifier for the reference.</p>","type":"string","constraints":["primary_key","unique","required"],"referenced_by":[{"table":"evidence_claim","column":"citation_id"}],"examples":["citation:smith2024"]},{"name":"key","label":"Key","description":"<p>Key the text cites it by, as <code>[@key]</code>.</p>","type":"string","constraints":["required"],"examples":["smith2024"]},{"name":"doi","label":"DOI","description":"<p>DOI, when the reference has one.</p>","type":"string","examples":["10.1021/acs.macromol.4c00123"]},{"name":"title","label":"Title","description":"<p>Title of the work.</p>","type":"string","examples":["Cure kinetics of epoxy-amine networks"]},{"name":"authors","label":"Authors","description":"<p>Authors as written in the source, separated by semicolons.</p>","type":"string","examples":["Smith, J.; Lee, K."]},{"name":"year","label":"Year","description":"<p>Year of publication.</p>","type":"string","examples":["2024"]},{"name":"url","label":"URL","description":"<p>Where the work can be read.</p>","type":"string","examples":["https://doi.org/10.1021/acs.macromol.4c00123"]}]},{"name":"evidence_claim","label":"Evidence","description":"<p>Each row is one claim in an evidence table, with its support.</p>","columns":[{"name":"id","label":"Claim ID","description":"<p>Stable identifier for the claim.</p>","type":"string","constraints":["primary_key","unique","required"],"examples":["claim:conv-7:card-15:3"]},{"name":"artifact_version_id","label":"Evidence table","description":"<p>Artifact version whose evidence table holds the claim.</p>","type":"string","constraints":["foreign_key","required"],"references":{"table":"artifact_version","column":"id"},"examples":["artifact:polymer-cure:conv-7:card-15:v1"]},{"name":"claim","label":"Claim","description":"<p>The claim as stated.</p>","type":"string","constraints":["required"],"examples":["Gel time falls with temperature"]},{"name":"value","label":"Value","description":"<p>The value the claim reports, as written.</p>","type":"string","examples":["12 min at 80C"]},{"name":"source","label":"Source","description":"<p>The source as written, a <code>[@key]</code> or free text.</p>","type":"string","examples":["[@smith2024]"]},{"name":"citation_id","label":"Citation","description":"<p>The reference, when the source is a known key.</p>","type":"string","constraints":["foreign_key"],"references":{"table":"citation","column":"id"},"examples":["citation:smith2024"]},{"name":"quote","label":"Quote","description":"<p>Quote offered in support of the claim.</p>","type":"string","examples":["gel time decreased from 31 to 12 min"]},{"name":"quote_checked","label":"Quote checked","description":"<p>Whether the quote was found in what the tools read.</p>","type":"boolean","constraints":["required"]}]},{"name":"direction","label":"Directions","description":"<p>Each row is one line of work in a conversation's directions log.</p>","columns":[{"name":"id","label":"Direction ID","description":"<p>Stable identifier for the direction.</p>","type":"string","constraints":["primary_key","unique","required"],"examples":["direction:conv-7:cure-temperature"]},{"name":"conversation_id","label":"Conversation","description":"<p>Conversation whose log holds the direction.</p>","type":"string","constraints":["required"],"examples":["conv-7"]},{"name":"area","label":"Direction","description":"<p>The line of work.</p>","type":"string","constraints":["required"],"examples":["Cure temperature"]},{"name":"status","label":"Status","description":"<p>Where the line of work stands.</p>","type":"enum","constraints":["required"],"values":["Explored","Partly explored","In progress","Blocked","Not pursued"]},{"name":"notes","label":"Notes","description":"<p>Notes on the direction, separated by semicolons.</p>","type":"string","examples":["80C is fastest; lot 22B only"]}]}],"relationships":[{"description":"<p>Resolves each version to its artifact.</p>","cardinality":"many-to-one","declared_cardinality":"many-to-one","pairs":[{"left":{"table":"artifact_version","column":"artifact_id"},"right":{"table":"artifact","column":"id"}}],"join":"artifact_version.artifact_id = artifact.id"},{"description":"<p>Resolves each version to its bytes.</p>","cardinality":"many-to-one","declared_cardinality":"many-to-one","pairs":[{"left":{"table":"artifact_version","column":"blob_id"},"right":{"table":"graft_blob","column":"id"}}],"join":"artifact_version.blob_id = graft_blob.id"},{"description":"<p>Resolves each version to how it was made.</p>","cardinality":"many-to-one","declared_cardinality":"many-to-one","pairs":[{"left":{"table":"artifact_version","column":"provenance_id"},"right":{"table":"artifact_provenance","column":"id"}}],"join":"artifact_version.provenance_id = artifact_provenance.id"},{"description":"<p>Resolves each claim to its evidence table.</p>","cardinality":"many-to-one","declared_cardinality":"many-to-one","pairs":[{"left":{"table":"evidence_claim","column":"artifact_version_id"},"right":{"table":"artifact_version","column":"id"}}],"join":"evidence_claim.artifact_version_id = artifact_version.id"},{"description":"<p>Resolves each claim to its reference.</p>","cardinality":"many-to-one","declared_cardinality":"many-to-one","pairs":[{"left":{"table":"evidence_claim","column":"citation_id"},"right":{"table":"citation","column":"id"}}],"join":"evidence_claim.citation_id = citation.id"}]}
